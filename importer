-- FILE SCANNER
local function safeListFiles(path)
    if type(listfiles) ~= "function" then return nil end
    local ok, result = pcall(listfiles, path); return ok and result or nil
end
local function getFileName(path) return path:match("([^/\\]+)$") or path end
local function looksFolder(path) return not getFileName(path):match("%.[%a%d]+$") end
local SCAN_PATHS = {
    "workspace","Delta/workspace","delta/workspace","Android/Delta/workspace",
    "/sdcard/Delta/workspace","/sdcard/Android/Delta/workspace","../workspace",".",""
}
local function normalizeFsPath(path)
    local p = tostring(path or ""):gsub("\\", "/"):lower()
    p = p:gsub("/+", "/"):gsub("^%./", ""):gsub("^%.%./", ""):gsub("/$", "")
    return p
end
local function canonicalWorkspacePath(path)
    local p = normalizeFsPath(path)
    local lastWorkspace; local searchFrom = 1
    while true do
        local s, e = p:find("workspace/", searchFrom, true); if not s then break end
        lastWorkspace = e + 1; searchFrom = e + 1
    end
    if lastWorkspace then return p:sub(lastWorkspace) end
    if p == "workspace" then return "" end
    return p
end
local function scanDeep(folder, depth, results, seenFolders, seenFiles)
    if depth > 4 then return end
    local folderKey = canonicalWorkspacePath(folder); if folderKey == "" then folderKey = "__root__" end
    if seenFolders[folderKey] then return end
    seenFolders[folderKey] = true
    local list = safeListFiles(folder); if not list then return end
    for _, path in ipairs(list) do
        local name = getFileName(path); local lower = name:lower()
        local ftype
        if lower:match("%.rbxl$") or lower:match("%.rbxlx$") then ftype = "RBXL"
        elseif lower:match("%.rbxm$") or lower:match("%.rbxmx$") then ftype = "RBXM" end
        if ftype then
            local fileKey = canonicalWorkspacePath(path); if fileKey == "" then fileKey = lower end
            if not seenFiles[fileKey] then
                seenFiles[fileKey] = true
                table.insert(results, { name = name, path = path, folder = folder, ftype = ftype, canonicalKey = fileKey })
            end
        elseif looksFolder(path) then scanDeep(path, depth + 1, results, seenFolders, seenFiles) end
    end
end
local function scanAllSupported()
    local results = {}; local seenFolders = {}; local seenFiles = {}
    for _, path in ipairs(SCAN_PATHS) do
        if safeListFiles(path) then scanDeep(path, 0, results, seenFolders, seenFiles) end
    end
    table.sort(results, function(a, b)
        local an = a.name:lower(); local bn = b.name:lower()
        if an == bn then return tostring(a.canonicalKey or a.path) < tostring(b.canonicalKey or b.path) end
        return an < bn
    end)
    return results
end

