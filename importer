-- ============================================================
-- SCAN
-- ============================================================
local function scanNow()
    -- cegah scan ganda (klik berulang / auto-scan bersamaan)
    if scanBusy then return end
    scanBusy = true

    scanBtn.Text = "SCANNING"
    scanBtn.BackgroundColor3 = P.warn
    setStatus("SCANNING WORKSPACE", P.warn)
    clearCards()
    fileCount = 0
    importedCount = 0
    updateCount()
    empty.Visible = true
    empty.Text = "SCANNING..."
    filterCards()

    local function finish()
        scanBtn.Text = "SCAN"
        scanBtn.BackgroundColor3 = P.neonPurple
        scanBusy = false
    end

    task.spawn(function()
        if type(listfiles) ~= "function" then
            empty.Text = "LISTFILES API NOT AVAILABLE"
            setStatus("ERROR: listfiles tidak tersedia", P.danger)
            finish()
            return
        end
        local ok, results = pcall(scanAllSupported)
        if not ok then
            empty.Text = "SCAN FAILED"
            setStatus("SCAN ERROR: " .. tostring(results), P.danger)
            finish()
            return
        end

        -- dedupe berdasarkan path kanonik (lapisan pengaman kedua)
        local seen = {}
        local unique = {}
        for _, info in ipairs(results) do
            local key = info.canonicalKey or tostring(info.path):lower()
            if not seen[key] then
                seen[key] = true
                unique[#unique + 1] = info
            end
        end

        for _, info in ipairs(unique) do makeCard(info); task.wait() end
        fileCount = #unique
        updateCount()
        if fileCount == 0 then
            empty.Visible = true
            empty.Text = "NO .RBXL / .RBXLX / .RBXM / .RBXMX FILES FOUND"
            setStatus("SCAN COMPLETE • 0 FILES", P.warn)
        else
            empty.Visible = false
            local rbxlCount = 0; local rbxmCount = 0
            for _, info in ipairs(unique) do
                if info.ftype == "RBXM" then rbxmCount += 1 else rbxlCount += 1 end
            end
            setStatus(("SCAN COMPLETE • RBXL %d • RBXM %d"):format(rbxlCount, rbxmCount), P.ok)
        end
        finish()
        -- otomatis pindah ke tab yang ada isinya
        local nl, nm = 0, 0
        for _, info in ipairs(unique) do
            if info.ftype == "RBXM" then nm += 1 else nl += 1 end
        end
        if activeTab == "RBXL" and nl == 0 and nm > 0 then activeTab = "RBXM"
        elseif activeTab == "RBXM" and nm == 0 and nl > 0 then activeTab = "RBXL" end
        filterCards()
    end)
end

