        local launcherStartPos

        launcher.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                launcherDragging = true
                launcherMoved = false
                launcherDragStart = input.Position
                launcherStartPos = launcher.Position
                input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then
                        launcherDragging = false
                        if not launcherMoved then setMainVisible(not mainVisible) end
                    end
                end)
            end
        end)

        UserInputService.InputChanged:Connect(function(input)
            if not launcherDragging then return end
            if input.UserInputType == Enum.UserInputType.MouseMovement
                or input.UserInputType == Enum.UserInputType.Touch then
                local delta = input.Position - launcherDragStart
                if math.abs(delta.X) > 5 or math.abs(delta.Y) > 5 then launcherMoved = true end
                if launcherMoved then
                    local np = UDim2.new(
                        launcherStartPos.X.Scale, launcherStartPos.X.Offset + delta.X,
                        launcherStartPos.Y.Scale, launcherStartPos.Y.Offset + delta.Y
                    )
                    launcher.Position = np
                    launcherGlow.Position = UDim2.new(np.X.Scale, np.X.Offset - 3, np.Y.Scale, np.Y.Offset - 3)
                end
            end
        end)
end

