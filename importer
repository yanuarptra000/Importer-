local function clearCards()
    for _, item in ipairs(allCards) do if item.card then item.card:Destroy() end end
    allCards = {}
end

local function filterCards()
    local q = searchBox.Text:lower():gsub("^%s+", ""):gsub("%s+$", "")
    local visibleCount = 0
    for _, item in ipairs(allCards) do
        local match = q == "" or item.info.name:lower():find(q, 1, true) or item.info.path:lower():find(q, 1, true)
        local show = (item.info.ftype == activeTab) and (match ~= nil and match ~= false)
        item.card.Visible = show
        if show then visibleCount += 1 end
    end
    if refreshTabs then refreshTabs() end
    if visibleCount > 0 then
        empty.Visible = false
    else
        empty.Visible = true
        if scanBusy then
            empty.Text = "SCANNING..."
        elseif #allCards > 0 then
            if q ~= "" then
                empty.Text = "NO MATCH IN " .. activeTab
            else
                empty.Text = "NO " .. activeTab .. " FILES"
            end
        end
    end
end

