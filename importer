    elseif tag == "BinaryString" or tag == "SharedString" then return xmlDecodeText(inner)
    elseif tag == "bool" then local v = tostring(inner):match("^%s*(.-)%s*$"); return v == "true" or v == "1"
    elseif tag == "int" or tag == "int64" or tag == "float" or tag == "double" then return tonumber(tostring(inner):match("^%s*(.-)%s*$"))
    elseif tag == "token" then return tonumber(tostring(inner):match("^%s*(.-)%s*$")), 0x12
    elseif tag == "Ref" then
        local target = xmlDecodeText(inner):match("^%s*(.-)%s*$")
        if target == "" or target == "null" then return nil, 0x13 end
        return {__XMLRef = target}, 0x13
    elseif tag == "Vector3" then
        local x = xmlNumber(inner,"X") or 0; local y = xmlNumber(inner,"Y") or 0; local z = xmlNumber(inner,"Z") or 0
        return Vector3.new(x,y,z)
    elseif tag == "Vector2" then
        local x = xmlNumber(inner,"X") or 0; local y = xmlNumber(inner,"Y") or 0
        return Vector2.new(x,y)
    elseif tag == "Color3" then
        local r = xmlNumber(inner,"R") or 0; local g = xmlNumber(inner,"G") or 0; local b = xmlNumber(inner,"B") or 0
        return Color3.new(r,g,b)
    elseif tag == "Color3uint8" then
        local packed = tonumber(tostring(inner):match("^%s*(%d+)%s*$")); if not packed then return nil end
        local r = math.floor(packed/65536)%256; local g = math.floor(packed/256)%256; local b = packed%256
        return Color3.fromRGB(r,g,b)
    elseif tag == "CoordinateFrame" or tag == "CFrame" then
        local x=xmlNumber(inner,"X") or 0; local y=xmlNumber(inner,"Y") or 0; local z=xmlNumber(inner,"Z") or 0
        local r00=xmlNumber(inner,"R00") or 1; local r01=xmlNumber(inner,"R01") or 0; local r02=xmlNumber(inner,"R02") or 0
        local r10=xmlNumber(inner,"R10") or 0; local r11=xmlNumber(inner,"R11") or 1; local r12=xmlNumber(inner,"R12") or 0
        local r20=xmlNumber(inner,"R20") or 0; local r21=xmlNumber(inner,"R21") or 0; local r22=xmlNumber(inner,"R22") or 1
        return CFrame.new(x,y,z,r00,r01,r02,r10,r11,r12,r20,r21,r22)
    elseif tag == "OptionalCoordinateFrame" then
        if inner:find("<CFrame>",1,true) then local body = inner:match("<CFrame>(.-)</CFrame>") or inner; return xmlPropertyValue("CFrame", body) end
        return nil
    elseif tag == "UDim" then
        local s = xmlNumber(inner,"S") or 0; local o = xmlNumber(inner,"O") or 0; return UDim.new(s,o)
    elseif tag == "UDim2" then
        local xs = xmlNumber(inner,"XS") or 0; local xo = xmlNumber(inner,"XO") or 0
        local ys = xmlNumber(inner,"YS") or 0; local yo = xmlNumber(inner,"YO") or 0
        return UDim2.new(xs,xo,ys,yo)
    elseif tag == "BrickColor" then
        local n = tonumber(tostring(inner):match("^%s*(%d+)%s*$"))
        if n then local ok, value = pcall(BrickColor.new, n); if ok then return value end end
        return nil
    elseif tag == "Content" then
