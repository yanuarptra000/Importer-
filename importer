-- ============================================================
do
        local resizing = false
        local resizeStart
        local resizeStartSize
        local resizeStartPos

        resizeGrip.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                resizing = true
                resizeStart = input.Position
                resizeStartSize = main.Size
                resizeStartPos = main.Position
            end
        end)

        resizeGrip.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                resizing = false
            end
        end)

        UserInputService.InputChanged:Connect(function(input)
            if not resizing then return end
            if input.UserInputType == Enum.UserInputType.MouseMovement
                or input.UserInputType == Enum.UserInputType.Touch then
                local delta = input.Position - resizeStart
                local newW = math.clamp(resizeStartSize.X.Offset + delta.X, MIN_W, MAX_W)
                local newH = math.clamp(resizeStartSize.Y.Offset + delta.Y, MIN_H, MAX_H)

                main.Size = UDim2.fromOffset(newW, newH)
                main.Position = resizeStartPos
                expandedPosition = main.Position

                outerGlow.Size = UDim2.fromOffset(newW + 18, newH + 18)
                outerGlow.Position = UDim2.new(
                    main.Position.X.Scale, main.Position.X.Offset - 9,
                    main.Position.Y.Scale, main.Position.Y.Offset - 9
                )
            end
        end)
end

-- ============================================================
-- DRAG LOGIC (header)
-- ============================================================
do
        local dragging = false
        local dragInput
        local dragStart
        local startPos
        local dragStarted = false

        local function headerInputStart(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                -- ignore if clicking buttons
                local mx = input.Position.X
                local my = input.Position.Y
                local closePos = closeBtn.AbsolutePosition
                local closeSize = closeBtn.AbsoluteSize
                if mx >= closePos.X and mx <= closePos.X + closeSize.X
                    and my >= closePos.Y and my <= closePos.Y + closeSize.Y then
                    return
                end
                local minPos = minBtn.AbsolutePosition
                local minSize = minBtn.AbsoluteSize
                if mx >= minPos.X and mx <= minPos.X + minSize.X
                    and my >= minPos.Y and my <= minPos.Y + minSize.Y then
                    return
                end
                dragging = true
                dragStart = input.Position
                startPos = main.Position
                input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then
                        dragging = false
                    end
                end)
            end
        end

        header.InputBegan:Connect(headerInputStart)

        header.InputChanged:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseMovement
                or input.UserInputType == Enum.UserInputType.Touch then
                dragInput = input
            end
        end)

        UserInputService.InputChanged:Connect(function(input)
            if dragging and input == dragInput and mainVisible then
                local delta = input.Position - dragStart
                main.Position = UDim2.new(
                    startPos.X.Scale, startPos.X.Offset + delta.X,
                    startPos.Y.Scale, startPos.Y.Offset + delta.Y
                )
                expandedPosition = main.Position
                outerGlow.Position = UDim2.new(
                    main.Position.X.Scale, main.Position.X.Offset - 9,
                    main.Position.Y.Scale, main.Position.Y.Offset - 9
                )
            end
        end)
end

